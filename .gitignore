# ==============================================================================
# AURASKIN AI - Production .gitignore
# Full-Stack: FastAPI Microservices, React (Vite), PostgreSQL, MongoDB, Node.js
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Credential Files
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# Exception: Allow committed example/template configurations and public client build endpoints
!.env.example
!.env.*.example
!*.env.example
!frontend/.env.production
!frontend/.env.production.example

# ------------------------------------------------------------------------------
# 2. Python Artifacts & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Distribution, Packaging & Build
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Type Checking & Linting
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs (Vite / React)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
frontend/build/
.vite/
frontend/.vite/
dist-ssr/
*.local

# ------------------------------------------------------------------------------
# 4. Database Storage & Local Logs
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# Database local persistent volumes
mongodb-data/
postgres-data/
mongo_data/
postgres_data/

# Log files
*.log
logs/
*.log.*

# ------------------------------------------------------------------------------
# 5. IDE, Editors & Operating System Artifacts
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json.example

# JetBrains / PyCharm / WebStorm
.idea/

# Sublime Text & Editors
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files
scratch/
tmp/
temp/
